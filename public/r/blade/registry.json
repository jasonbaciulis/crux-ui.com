                "@crux/theme"
            ],
            "files": [
                {
                    "path": "views/components/ui/button.blade.php",
                    "type": "registry:file",
                    "target": "resources/views/components/ui/button.blade.php"
                }
            ]
        },
        {
            "name": "card",
            "type": "registry:item",
            "title": "Card",
