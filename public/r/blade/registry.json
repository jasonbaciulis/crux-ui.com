{
    "$schema": "https://ui.shadcn.com/schema/registry.json",
    "name": "crux",
    "homepage": "https://crux-ui.com",
    "items": [
        {
            "name": "theme",
            "type": "registry:item",
            "title": "Theme",
            "description": "The shadcn CSS variables every component reads.",
            "dependencies": [],
            "registryDependencies": [],
            "docs": "Import it from your stylesheet after Tailwind: @import './theme.css';",
            "files": [
                {
                    "path": "css/theme.css",
                    "type": "registry:file",
                    "target": "resources/css/theme.css"
                }
            ]
        },
        {
            "name": "button",
            "type": "registry:item",
            "title": "Button",
            "description": "A button with variants and sizes.",
            "dependencies": [],
